<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.Navigation.UriDemoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels.Navigation"
    x:DataType="vm:UriDemoViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout
            Padding="{DynamicResource Theme.Padding.Medium}"
            Spacing="{DynamicResource Theme.Spacing.Medium}">
            <Label Text="A navigation URI composes several pages in one call." />
            <Button
                Command="{Binding NavigateCommand}"
                CommandParameter="LifecycleDemoPage/LifecycleChildPage"
                Text="Push two pages at once" />
            <Button
                Command="{Binding NavigateCommand}"
                CommandParameter="../DeepLinkDetailPage"
                Text="Replace this page (../DeepLinkDetailPage)" />
            <Button
                Command="{Binding NavigateCommand}"
                CommandParameter="DeepLinkDetailPage?id=42&amp;source=demo"
                Text="Open with query parameters" />
            <Button
                Command="{Binding NavigateCommand}"
                CommandParameter="superdev://app/NavigationPage/DeepLinkDetailPage?id=7"
                Text="Open an application link (replaces the root page)" />
            <Label
                FontSize="12"
                Text="The application link replaces the root page, so use the demo list to navigate back afterwards." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
