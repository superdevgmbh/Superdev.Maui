<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.Navigation.LeakDemoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels.Navigation"
    x:DataType="vm:LeakDemoViewModel"
    Title="{Binding Title}">

    <VerticalStackLayout
        Padding="{DynamicResource Theme.Padding.Medium}"
        Spacing="{DynamicResource Theme.Spacing.Medium}">
        <Label Text="Every page gets its own service scope, which is disposed as soon as the page leaves the navigation stack." />
        <Button Command="{Binding PushHeavyPageCommand}" Text="Push a page holding 32 MB" />
        <Button Command="{Binding CollectCommand}" Text="Collect and check" />
        <Label Text="{Binding Status}" />
    </VerticalStackLayout>
</ContentPage>
