<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.Navigation.TabsFirstPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels.Navigation"
    x:DataType="vm:TabsDemoViewModel">

    <VerticalStackLayout
        Padding="{DynamicResource Theme.Padding.Medium}"
        Spacing="{DynamicResource Theme.Spacing.Medium}">
        <Label Text="The lifecycle callbacks are delivered to the active tab only - both when a tab is selected here and when you tap the tab bar." />
        <Button
            Command="{Binding SelectTabCommand}"
            CommandParameter="TabsSecondPage"
            Text="Select the second tab" />
    </VerticalStackLayout>
</ContentPage>
