<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.Navigation.ParameterDemoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels.Navigation"
    x:DataType="vm:ParameterDemoViewModel"
    Title="{Binding Title}">

    <VerticalStackLayout
        Padding="{DynamicResource Theme.Padding.Medium}"
        Spacing="{DynamicResource Theme.Spacing.Medium}">
        <Label Text="A navigation parameter is any object. The target receives it through IInitialize&lt;T&gt; or INavigatedTo&lt;T&gt;." />
        <Button Command="{Binding PushWithParameterCommand}" Text="Push with a typed parameter" />

        <Label Text="A page can also return a result to the page which pushed it." />
        <Button Command="{Binding PickColorCommand}" Text="Pick a color (PushForResultAsync)" />
        <Label Text="{Binding SelectedColor, StringFormat='Selected color: {0}'}" />
    </VerticalStackLayout>
</ContentPage>
