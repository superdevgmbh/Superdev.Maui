<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.Navigation.ColorPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels.Navigation"
    x:DataType="vm:ColorPickerViewModel"
    Title="{Binding Title}">

    <VerticalStackLayout
        Padding="{DynamicResource Theme.Padding.Medium}"
        BindableLayout.ItemsSource="{Binding Colors}"
        Spacing="{DynamicResource Theme.Spacing.Medium}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="x:String">
                <Button
                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ColorPickerViewModel}}, Path=SelectCommand}"
                    CommandParameter="{Binding .}"
                    Text="{Binding .}" />
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentPage>
