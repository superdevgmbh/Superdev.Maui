<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.Navigation.TabsSecondPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels.Navigation"
    x:DataType="vm:TabsDemoViewModel">

    <VerticalStackLayout
        Padding="{DynamicResource Theme.Padding.Medium}"
        Spacing="{DynamicResource Theme.Spacing.Medium}">
        <Label Text="This tab is initialized the first time it is selected, and only once." />
        <Button
            Command="{Binding SelectTabCommand}"
            CommandParameter="TabsFirstPage"
            Text="Select the first tab" />
    </VerticalStackLayout>
</ContentPage>
