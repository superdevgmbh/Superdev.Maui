<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.Navigation.FlyoutDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels.Navigation"
    x:DataType="vm:FlyoutDetailViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout
            Padding="{DynamicResource Theme.Padding.Medium}"
            Spacing="{DynamicResource Theme.Spacing.Medium}">
            <Label
                FontAttributes="Bold"
                Text="Flyout detail" />
            <Label
                FontAttributes="Bold"
                Text="Lifecycle log (shared, survives page disposal)" />
            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding NavigationDebugLog.Entries}"
                Spacing="2">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label
                            FontSize="11"
                            Text="{Binding .}" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label
                FontSize="12"
                Text="Pushing works on the detail page's own navigation stack." />
            <Button
                Command="{Binding PushCommand}"
                Text="Push a page onto the detail stack" />
            <Button
                Command="{Binding OpenPopupCommand}"
                Text="Open a popup over the flyout" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
