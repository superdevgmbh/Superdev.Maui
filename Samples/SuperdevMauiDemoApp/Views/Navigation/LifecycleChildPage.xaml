<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.Navigation.LifecycleChildPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels.Navigation"
    x:DataType="vm:LifecycleChildViewModel"
    Title="{Binding Title}">

    <VerticalStackLayout
        Padding="{DynamicResource Theme.Padding.Medium}"
        Spacing="{DynamicResource Theme.Spacing.Medium}">
        <Label Text="Navigate back to see NavigatedFromAsync(Back) here and NavigatedToAsync(Back) on the page below." />
    </VerticalStackLayout>
</ContentPage>
