<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.Navigation.PopupDemoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels.Navigation"
    x:DataType="vm:PopupDemoViewModel"
    Title="{Binding Title}">

    <VerticalStackLayout
        Padding="{DynamicResource Theme.Padding.Medium}"
        Spacing="{DynamicResource Theme.Spacing.Medium}">
        <Label Text="A popup is a page: it is registered, navigated to and closed like any other page, and it takes part in the lifecycle, the service scopes and the navigation guards." />
        <Button Command="{Binding ShowContextMenuCommand}" Text="Bottom sheet (returns a result)" />
        <Button Command="{Binding ShowTooltipCommand}" Text="Centered card" />
        <Button Command="{Binding ShowFormCommand}" Text="Sheet with a text input" />
        <Label Text="{Binding LastResult, StringFormat='Last result: {0}'}" />
    </VerticalStackLayout>
</ContentPage>
