<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.MarkupExtensionsDemoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:s="http://schemas.superdev.ch/dotnet/2021/maui"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels"
    Title="MarkupExtensionsDemoPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="{DynamicResource Theme.Padding.Medium}"
            Spacing="{DynamicResource Theme.Spacing.Medium}">

            <Label
                Style="{StaticResource DemoLabelStyle}"
                Text="EmbeddedResource" />
            <Image
                x:Name="EmbeddedImage"
                Source="{s:EmbeddedResource embedded_resource_logo.png}" />

            <Label
                Style="{StaticResource DemoLabelStyle}"
                Text="The same image source again: each image opens its own resource stream" />
            <Image Source="{Binding Source, Source={x:Reference EmbeddedImage}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>