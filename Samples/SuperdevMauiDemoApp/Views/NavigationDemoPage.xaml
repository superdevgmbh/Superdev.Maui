<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.NavigationDemoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Superdev.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Superdev.Maui"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels"
    x:DataType="vm:NavigationDemoViewModel"
    ios:NavigationPage.SwipeBackEnabled="{Binding SwipeBackEnabled}"
    NavigationPage.BackButtonTitle="Back"
    NavigationPage.HasBackButton="True"
    NavigationPage.HasNavigationBar="{Binding HasNavigationBar}"
    Title="NavigationDemoPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="{DynamicResource Theme.Padding.Medium}"
            Spacing="{DynamicResource Theme.Spacing.Medium}">
            <Label
                Style="{StaticResource DemoLabelStyle}"
                Text="Navigation demos" />
            <Button
                Command="{Binding NavigateToPageCommand}"
                CommandParameter="LifecycleDemoPage"
                Text="Lifecycle and events" />
            <Button
                Command="{Binding NavigateToPageCommand}"
                CommandParameter="ParameterDemoPage"
                Text="Parameters and results" />
            <Button
                Command="{Binding NavigateToPageCommand}"
                CommandParameter="GuardDemoPage"
                Text="Navigation guard" />
            <Button
                Command="{Binding NavigateToPageCommand}"
                CommandParameter="PopupDemoPage"
                Text="Popups" />
            <Button
                Command="{Binding NavigateToPageCommand}"
                CommandParameter="TabsDemoPage"
                Text="Tabs" />
            <Button
                Command="{Binding NavigateToPageCommand}"
                CommandParameter="UriDemoPage"
                Text="Navigation URIs and deep links" />
            <Button
                Command="{Binding NavigateToPageCommand}"
                CommandParameter="LeakDemoPage"
                Text="Leak playground" />
            <Button
                Command="{Binding NavigateToUriCommand}"
                CommandParameter="/FlyoutDemoPage/NavigationPage/FlyoutHomePage"
                Text="Flyout shell (replaces the root page)" />

            <Label
                Style="{StaticResource DemoLabelStyle}"
                Text="Navigation" />
            <Button
                Command="{Binding NavigateToPageCommand}"
                CommandParameter="NavigationDemoPage"
                Text="PushAsync" />
            <Button
                Command="{Binding PopCommand}"
                Text="PopAsync" />
            <Button
                Command="{Binding PopToRootCommand}"
                Text="PopToRootAsync" />
            <Label
                Style="{StaticResource DemoLabelStyle}"
                Text="Modal Navigation" />
            <Button
                Command="{Binding NavigateToPageModalCommand}"
                CommandParameter="NavigationDemoPage"
                Text="PushModalAsync" />
            <!--  A guarded page is presented full screen on iOS, so that it cannot be swiped away past its guard.  -->
            <Button
                Command="{Binding NavigateToPageModalCommand}"
                CommandParameter="GuardDemoPage"
                Text="PushModalAsync (guarded page)" />
            <Button
                Command="{Binding PopModalCommand}"
                Text="PopModalAsync" />
            <Label
                Style="{StaticResource DemoLabelStyle}"
                Text="NavigationPage" />
            <Button
                Command="{Binding ToggleHasNavigationBarCommand}"
                Text="{Binding HasNavigationBar, StringFormat='HasNavigationBar={0}'}" />
            <Label
                Style="{StaticResource DemoLabelStyle}"
                Text="NavigationPage (iOS)" />
            <Button
                Command="{Binding ToggleSwipeBackEnabledCommand}"
                Text="{Binding SwipeBackEnabled, StringFormat='SwipeBackEnabled={0} (iOS)'}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>