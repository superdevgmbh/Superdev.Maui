<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SuperdevMauiDemoApp.Views.CollectionViewDemoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:s="http://schemas.superdev.ch/dotnet/2021/maui"
    xmlns:templates="clr-namespace:SuperdevMauiDemoApp.Views.ItemTemplates"
    xmlns:vm="clr-namespace:SuperdevMauiDemoApp.ViewModels"
    x:Name="Page"
    x:DataType="vm:CollectionViewDemoViewModel"
    Title="CollectionViewDemoPage">

    <ContentPage.Resources>
        <DataTemplate x:Key="CountryItemTemplate">
            <templates:CountryCollectionItemTemplate />
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <Grid
            Grid.Row="0"
            RowDefinitions="*,Auto">
            <RefreshView
                Grid.Row="0"
                Command="{Binding RefreshCommand}"
                IsRefreshing="{Binding IsRefreshing}">
                <CollectionView
                    s:CollectionViewExtensions.ScrollTo="{Binding ScrollToCountry}"
                    ItemSizingStrategy="MeasureFirstItem"
                    ItemTemplate="{StaticResource CountryItemTemplate}"
                    ItemsSource="{Binding Countries}" />
            </RefreshView>
            <Button
                Grid.Row="1"
                Command="{Binding ScrollToPositionCommand}"
                Text="Scroll to position" />
        </Grid>

        <s:ViewModelErrorControl
            Grid.Row="0"
            ViewModelError="{Binding ViewModelError}" />
    </Grid>
</ContentPage>
