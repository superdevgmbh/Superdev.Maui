<?xml version="1.0" encoding="utf-8" ?>
<Grid
    x:Class="Superdev.Maui.Controls.DrilldownButtonList"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Superdev.Maui.Controls;assembly=Superdev.Maui"
    x:Name="Control"
    BackgroundColor="{DynamicResource CardViewStyle.BackgroundColor}"
    HorizontalOptions="Fill"
    VerticalOptions="Start">

    <Grid.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DrilldownControlTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="CustomDrilldownTemplate">
                <ContentView ControlTemplate="{StaticResource DrilldownControlTemplate}">
                    <controls:ContentControl
                        BindingContext="{Binding .}"
                        ItemTemplate="{Binding Source={x:Reference Control}, Path=ItemTemplate}" />
                </ContentView>
            </DataTemplate>

            <!--  The item templates expose their content as properties; the item of the template feeds them.  -->
            <DataTemplate
                x:Key="DrilldownButtonItemTemplate"
                x:DataType="controls:DrilldownButtonView">
                <controls:DrilldownButtonItemTemplate
                    Command="{Binding Command, Mode=OneWay}"
                    CommandParameter="{Binding CommandParameter, Mode=OneWay}"
                    ImageSource="{Binding ImageSource, Mode=OneWay}"
                    IsBusy="{Binding IsBusy, Mode=OneWay}"
                    IsEnabled="{Binding IsEnabled, Mode=OneWay}"
                    Text="{Binding Title, Mode=OneWay}" />
            </DataTemplate>

            <DataTemplate
                x:Key="DrilldownSwitchItemTemplate"
                x:DataType="controls:DrilldownSwitchView">
                <controls:DrilldownSwitchItemTemplate
                    Command="{Binding Command, Mode=OneWay}"
                    CommandParameter="{Binding CommandParameter, Mode=OneWay}"
                    IsEnabled="{Binding IsEnabled, Mode=OneWay}"
                    IsToggled="{Binding IsToggled, Mode=TwoWay}"
                    Text="{Binding Title, Mode=OneWay}" />
            </DataTemplate>

            <controls:DrilldownItemTemplateSelector
                x:Key="DrilldownItemTemplateSelector"
                CustomDrilldownTemplate="{StaticResource CustomDrilldownTemplate}"
                DrilldownButtonTemplate="{StaticResource DrilldownButtonItemTemplate}"
                DrilldownSwitchTemplate="{StaticResource DrilldownSwitchItemTemplate}" />
        </ResourceDictionary>
    </Grid.Resources>

    <VerticalStackLayout
        BackgroundColor="{DynamicResource CardViewStyle.DividerColor}"
        BindableLayout.ItemTemplateSelector="{StaticResource DrilldownItemTemplateSelector}"
        BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference Control}, Mode=OneWay}"
        Spacing="1" />
</Grid>