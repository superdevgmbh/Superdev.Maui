<?xml version="1.0" encoding="UTF-8" ?>

<SwipeItemView
    x:Class="Superdev.Maui.Controls.SwipeItemBase"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Superdev.Maui.Controls">

    <!-- No bindings: every list row builds its swipe items, so the code-behind sets these children directly. -->
    <VerticalStackLayout
        Spacing="2"
        HorizontalOptions="Center"
        VerticalOptions="Center">
        <Image
            x:Name="IconImage"
            Margin="0"
            Aspect="AspectFit"
            HeightRequest="24"
            WidthRequest="24"
            VerticalOptions="End" />
        <controls:CustomLabel
            x:Name="TextLabel"
            Margin="0"
            Padding="0"
            IsVisible="False"
            LineBreakMode="TailTruncation"
            MaxLines="2"
            RemovePadding="True"
            HorizontalOptions="Center"
            VerticalOptions="Start"
            HorizontalTextAlignment="Center"
            VerticalTextAlignment="Start" />
    </VerticalStackLayout>
</SwipeItemView>
